{
  "name": "@local/cli-tools",
  "version": "1.0.0",
  "description": "Consolidated CLI tools for thesis processing, image generation, PDF manipulation, reference management, and statistics",
  "type": "module",
  "private": true,
  "workspaces": [
    "chapter-tools",
    "image-gen-ts",
    "pdf-tools",
    "ref-tools",
    "stats"
  ],
  "scripts": {
    "install:all": "npm install",
    "build": "echo 'Build placeholder - TypeScript projects use tsx for direct execution'",
    "clean": "rm -rf node_modules package-lock.json && npm install",
    "lint": "biome check .",
    "format": "biome format . --write"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.5.3",
    "@sylphide/pdf-actions": "^1.1.3",
    "@types/mdast": "^4.0.4",
    "commander": "^14.0.2",
    "dotenv": "^17.2.3",
    "mdast": "^2.3.2",
    "mdast-util-from-markdown": "^2.0.2",
    "mdast-util-gfm": "^3.0.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "node-fetch": "^3.3.2",
    "p-limit": "^6.2.0",
    "playwright": "^1.57.0",
    "playwright-chromium": "^1.57.0",
    "string-similarity": "^4.0.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@types/node": "^25.0.3",
    "@types/string-similarity": "^4.0.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "author": "Thesis Author",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  }
}
