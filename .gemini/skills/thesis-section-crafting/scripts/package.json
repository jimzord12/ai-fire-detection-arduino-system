{
  "name": "thesis-section-crafting-scripts",
  "version": "1.0.0",
  "description": "TypeScript scripts for thesis section crafting and processing",
  "type": "module",
  "main": "markdown_to_typst_converter.ts",
  "scripts": {
    "convert:md-to-typst": "tsx markdown_to_typst_converter.ts",
    "extract:bibliography": "tsx extract_bibliography.ts",
    "extract:glossary": "tsx extract_glossary_terms.ts",
    "include:section": "tsx include_section_in_chapter.ts",
    "process:citations": "tsx ieee_cite_processor.ts",
    "create:section": "tsx create_section_draft.ts",
    "verify:references": "tsx verify_references.ts"
